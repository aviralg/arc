################################################################################
## Elisp - https://github.com/github/gitignore/blob/main/Elisp.gitignore
################################################################################

# Compiled
*.elc

# Packaging
.cask/
.eask/
.eldev/
.keg/

# Built distribution
dist/

# Backup files
*~

# Undo-tree save-files
*.~undo-tree

################################################################################
## Emacs - Project-specific generated by this config
################################################################################

# Installed packages (reproducible from my--required-packages)
elpa/

# no-littering directories (state/ = runtime data, config/ = custom.el etc.)
state/
config/

# Native compilation cache (default location + redirected location is in state/)
eln-cache/
*.eln

# Tree-sitter grammar binaries (platform-specific, reinstallable)
tree-sitter/

# Local overrides (machine-specific, not committed)
compile-commands.el
